<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SDock.App.ViewModels"
        x:Class="SDock.App.Views.ArtPickerWindow"
        x:DataType="vm:ArtPickerViewModel"
        Title="Choose Image"
        Width="920" Height="640" MinWidth="620" MinHeight="420"
        WindowStartupLocation="CenterOwner">
  <DockPanel Margin="18">
    <StackPanel DockPanel.Dock="Top" Spacing="6" Margin="0,0,0,12">
      <TextBlock Text="{Binding Heading}" FontSize="17" FontWeight="Bold" TextWrapping="Wrap" />
      <TextBlock Text="{Binding Explanation}" Classes="muted" TextWrapping="Wrap" />
    </StackPanel>

    <Grid DockPanel.Dock="Bottom" ColumnDefinitions="Auto,Auto,*,Auto,Auto" Margin="0,12,0,0">
      <Button Content="From File…" Command="{Binding FromFileCommand}" Margin="0,0,8,0" />
      <Button Grid.Column="1" Content="Use Default" Command="{Binding UseDefaultCommand}"
              ToolTip.Tip="Remove your choice and use the automatic image again" />
      <Button Grid.Column="3" Content="Use" Classes="accent" MinWidth="90" HorizontalContentAlignment="Center"
              Command="{Binding ChooseCommand}" IsDefault="True" Margin="0,0,8,0" />
      <Button Grid.Column="4" Content="Cancel" MinWidth="90" HorizontalContentAlignment="Center"
              Command="{Binding CancelCommand}" IsCancel="True" />
    </Grid>

    <TextBlock DockPanel.Dock="Bottom" Text="{Binding Status}" Classes="muted" TextWrapping="Wrap" Margin="0,8,0,0" />

    <Grid>
      <ProgressBar IsIndeterminate="True" VerticalAlignment="Top" IsVisible="{Binding IsBusy}" />
      <ListBox x:Name="ChoiceList" ItemsSource="{Binding Choices}" SelectedItem="{Binding Selected}"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled" Background="Transparent">
        <ListBox.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel />
          </ItemsPanelTemplate>
        </ListBox.ItemsPanel>
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:ArtChoice">
            <StackPanel Width="272" Spacing="4" Margin="2">
              <!-- Mid-grey behind previews so both light and dark clear logos are visible -->
              <Border Height="153" CornerRadius="6" ClipToBounds="True" Background="#3A3F47">
                <Panel>
                  <Image Source="{Binding Thumbnail}" Stretch="Uniform" Margin="6" />
                  <TextBlock Text="Preview unavailable" Classes="muted" HorizontalAlignment="Center" VerticalAlignment="Center"
                             IsVisible="{Binding Failed}" />
                </Panel>
              </Border>
              <TextBlock Text="{Binding Detail}" Classes="muted" FontSize="12" TextTrimming="CharacterEllipsis" />
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Grid>
  </DockPanel>
</Window>
