<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SDock.App.ViewModels"
        xmlns:c="using:SDock.App.Controls"
        x:Class="SDock.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="S-Dock"
        Icon="avares://S-Dock/Assets/sdock.ico"
        Width="1280" Height="820" MinWidth="960" MinHeight="640"
        WindowStartupLocation="CenterScreen" WindowState="Maximized">
  <Window.KeyBindings>
    <KeyBinding Gesture="Ctrl+O" Command="{Binding AddFolderCommand}" />
    <KeyBinding Gesture="Ctrl+E" Command="{Binding EmulatorSettingsCommand}" />
    <KeyBinding Gesture="Ctrl+Tab" Command="{Binding NextLibraryCommand}" />
    <KeyBinding Gesture="Ctrl+Shift+Tab" Command="{Binding PreviousLibraryCommand}" />
    <KeyBinding Gesture="Ctrl+G" Command="{Binding ToggleViewCommand}" />
    <KeyBinding Gesture="Ctrl+D" Command="{Binding ToggleFavoriteCommand}" />
  </Window.KeyBindings>

  <Window.Styles>
    <!-- The star on a favorite cover. -->
    <Style Selector="Border.favstar">
      <Setter Property="HorizontalAlignment" Value="Right" />
      <Setter Property="VerticalAlignment" Value="Top" />
      <Setter Property="Margin" Value="8" />
      <Setter Property="Width" Value="30" />
      <Setter Property="Height" Value="30" />
      <Setter Property="CornerRadius" Value="15" />
      <Setter Property="Background" Value="#CC10111E" />
      <Setter Property="IsHitTestVisible" Value="False" />
    </Style>
    <Style Selector="Border.favstar > TextBlock">
      <Setter Property="Foreground" Value="#FFD54F" />
      <Setter Property="FontSize" Value="18" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.fav TextBlock">
      <Setter Property="Foreground" Value="#FFD54F" />
    </Style>
    <!-- Grid: a lavender ring marks the selected cover; no default list highlight. -->
    <Style Selector="ListBox#CoverList ListBoxItem">
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="6,8,6,10" />
      <Setter Property="FocusAdorner" Value="{x:Null}" />
    </Style>
    <Style Selector="ListBox#CoverList ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="ClipToBounds" Value="False" />
      <Setter Property="CornerRadius" Value="0" />
    </Style>
    <Style Selector="ListBox#CoverList ListBoxItem">
      <Setter Property="ClipToBounds" Value="False" />
    </Style>
    <Style Selector="ListBox#CoverList ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ListBox#CoverList ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ListBox#CoverList ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ListBox#CoverList ListBoxItem:selected:focus /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>

    <!-- The ring around a cover (grid and carousel) -->
    <Style Selector="Border.ring">
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="3" />
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="Padding" Value="2" />
      <Setter Property="RenderTransformOrigin" Value="50%,50%" />
      <Setter Property="RenderTransform" Value="scale(1)" />
      <Setter Property="Transitions">
        <Transitions>
          <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.12" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="ListBox#CoverList ListBoxItem:pointerover Border.ring">
      <Setter Property="RenderTransform" Value="scale(1.03)" />
    </Style>
    <Style Selector="ListBox#CoverList ListBoxItem:selected Border.ring">
      <Setter Property="BorderBrush" Value="{StaticResource SyAccent}" />
      <Setter Property="RenderTransform" Value="scale(1.04)" />
      <Setter Property="BoxShadow" Value="0 0 18 2 #66B996FF" />
    </Style>
    <Style Selector="TextBlock.card-title">
      <Setter Property="Foreground" Value="{StaticResource SyMuted}" />
      <Setter Property="FontSize" Value="13" />
    </Style>
    <Style Selector="ListBox#CoverList ListBoxItem:selected TextBlock.card-title">
      <Setter Property="Foreground" Value="{StaticResource SyText}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- Carousel: the selected cover is ~18% larger than its neighbours, with a glowing lavender ring. -->
    <Style Selector="ListBox#CarouselList ListBoxItem">
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="18,46" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="RenderTransformOrigin" Value="50%,50%" />
      <Setter Property="RenderTransform" Value="scale(1)" />
      <Setter Property="Opacity" Value="0.9" />
      <Setter Property="FocusAdorner" Value="{x:Null}" />
      <Setter Property="Transitions">
        <Transitions>
          <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.16" />
          <DoubleTransition Property="Opacity" Duration="0:0:0.16" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="ListBox#CarouselList ListBoxItem:selected">
      <Setter Property="RenderTransform" Value="scale(1.18)" />
      <Setter Property="Opacity" Value="1" />
      <Setter Property="ZIndex" Value="1" />
    </Style>
    <Style Selector="ListBox#CarouselList ListBoxItem:selected Border.ring">
      <Setter Property="BorderBrush" Value="{StaticResource SyAccent}" />
      <Setter Property="BoxShadow" Value="0 0 26 4 #8CB996FF" />
    </Style>
    <Style Selector="ListBox#CarouselList ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <!-- Let the selected cover's glow spill past its slot instead of being cut off square -->
      <Setter Property="ClipToBounds" Value="False" />
      <Setter Property="CornerRadius" Value="0" />
    </Style>
    <Style Selector="ListBox#CarouselList ListBoxItem">
      <Setter Property="ClipToBounds" Value="False" />
    </Style>
    <Style Selector="ListBox#CarouselList ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ListBox#CarouselList ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ListBox#CarouselList ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ListBox#CarouselList ListBoxItem:selected:focus /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>

    <!-- Details panel form rows -->
    <Style Selector="Grid.form > TextBlock">
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="0,0,10,0" />
      <Setter Property="Foreground" Value="{StaticResource SyMuted}" />
    </Style>
    <Style Selector="Grid.form > ComboBox">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="Margin" Value="0,3" />
    </Style>
  </Window.Styles>

  <Panel>
    <!-- ============================== Backdrop: the selected game's art ============================== -->
    <!-- Settings → Background: the game's artwork (over a generation tint), a gradient in its colour, or plain. -->
    <Border Background="{Binding BackdropBrush}" IsHitTestVisible="False" />
    <Image Source="{Binding SelectedKeyArt}" Stretch="UniformToFill" Opacity="{Binding BackdropOpacity}" IsHitTestVisible="False"
           IsVisible="{Binding BackgroundIsArt}">
      <Image.Transitions>
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.25" />
        </Transitions>
      </Image.Transitions>
    </Image>
    <Border IsHitTestVisible="False">
      <Border.Background>
        <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
          <GradientStop Offset="0" Color="#C010111E" />
          <GradientStop Offset="0.22" Color="#5010111E" />
          <GradientStop Offset="0.6" Color="#6010111E" />
          <GradientStop Offset="1" Color="#F010111E" />
        </LinearGradientBrush>
      </Border.Background>
    </Border>

    <DockPanel>
      <!-- ============================== Top bar ============================== -->
      <Border DockPanel.Dock="Top" Padding="28,14,24,10" BorderBrush="#2AFFFFFF" BorderThickness="0,0,0,1">
        <Grid ColumnDefinitions="Auto,Auto,*,Auto">
          <Image x:Name="Logo" Source="avares://S-Dock/Assets/logo.png" Height="46" VerticalAlignment="Center"
                 RenderOptions.BitmapInterpolationMode="HighQuality" ToolTip.Tip="S-Dock" />
          <Rectangle Grid.Column="1" Width="1" Height="38" Fill="#40FFFFFF" Margin="22,0" VerticalAlignment="Center" />
          <TabStrip Grid.Column="2" Classes="pills" Background="Transparent" VerticalAlignment="Center"
                    ItemsSource="{Binding LibraryTabs}" SelectedItem="{Binding SelectedLibraryTab}">
            <TabStrip.ItemTemplate>
              <DataTemplate x:DataType="vm:LibraryTab">
                <TextBlock Text="{Binding Header}" ToolTip.Tip="{Binding Tooltip}" />
              </DataTemplate>
            </TabStrip.ItemTemplate>
          </TabStrip>
          <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
            <Panel Width="230" IsVisible="{Binding IsGrid}">
              <TextBox x:Name="SearchBox" Classes="search" Text="{Binding SearchText}" PlaceholderText="Search (Ctrl+F)" />
              <PathIcon Data="{StaticResource IconSearch}" Width="15" Height="15" Margin="13,0,0,0"
                        HorizontalAlignment="Left" VerticalAlignment="Center" Foreground="{StaticResource SyMuted}"
                        IsHitTestVisible="False" />
            </Panel>
            <Button Classes="subtle" Width="44" Height="44" Padding="0" HorizontalContentAlignment="Center" IsVisible="{Binding IsGrid}"
                    Command="{Binding AddFolderCommand}" ToolTip.Tip="Add a folder of games (Ctrl+O)">
              <PathIcon Data="{StaticResource IconFolderPlus}" Width="20" Height="20" />
            </Button>
            <Button x:Name="SettingsButton" Classes="subtle" Width="44" Height="44" Padding="0" HorizontalContentAlignment="Center"
                    Command="{Binding OpenSettingsCommand}" ToolTip.Tip="Settings (Select / Back on a controller)">
              <PathIcon Data="{StaticResource IconSettings}" Width="22" Height="22" />
            </Button>
          </StackPanel>
        </Grid>
      </Border>

      <!-- ============================== Filters and view (grid only; the carousel stays clean) ============================== -->
      <Grid x:Name="FilterBar" DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="28,14,24,4" IsVisible="{Binding IsGrid}">
        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
          <ListBox Classes="pills" ItemsSource="{Binding PrimaryFilters}" SelectedItem="{Binding PillFilter}">
            <ListBox.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" />
              </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:FilterOption">
                <TextBlock Text="{Binding Label}" />
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <ComboBox Classes="chip" ItemsSource="{Binding MoreFilters}" SelectedItem="{Binding MoreFilter}"
                    PlaceholderText="More filters" MinWidth="150" ToolTip.Tip="Unclassified, update available, not in TitleDB, hidden games" />
          <ComboBox Classes="chip" ItemsSource="{Binding SeriesFilterOptions}" SelectedItem="{Binding SeriesFilter}" MinWidth="160"
                    IsVisible="{Binding IsArcade}" />
          <Button Classes="subtle" Content="Clear" Command="{Binding ClearFiltersCommand}" IsVisible="{Binding HasActiveFilters}" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
          <ToggleButton Classes="seg" IsChecked="{Binding IsGrid, Mode=OneWay}" Command="{Binding ShowGridCommand}" ToolTip.Tip="Grid (Ctrl+G, or Y)">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <PathIcon Data="{StaticResource IconGridOutline}" Width="18" Height="18" />
              <TextBlock Text="Grid" />
            </StackPanel>
          </ToggleButton>
          <ToggleButton Classes="seg" IsChecked="{Binding IsCarousel, Mode=OneWay}" Command="{Binding ShowCarouselCommand}"
                        ToolTip.Tip="Carousel (Ctrl+G, or Y)">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <PathIcon Data="{StaticResource IconCarouselOutline}" Width="20" Height="18" />
              <TextBlock Text="Carousel" />
            </StackPanel>
          </ToggleButton>
        </StackPanel>
      </Grid>

      <!-- ============================== Footer: controller hints and status ============================== -->
      <Border DockPanel.Dock="Bottom" Padding="28,10" Background="#E610111E" BorderBrush="#2AFFFFFF" BorderThickness="0,1,0,0">
        <Grid ColumnDefinitions="Auto,*">
          <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
            <Border Classes="key"><TextBlock Text="←" /></Border>
            <Border Classes="key"><TextBlock Text="→" /></Border>
            <TextBlock Text="Browse" VerticalAlignment="Center" Margin="2,0,22,0" />
            <Border Classes="key round"><TextBlock Text="A" /></Border>
            <TextBlock Text="Play" VerticalAlignment="Center" Margin="2,0,22,0" />
            <Border Classes="key round"><TextBlock Text="X" /></Border>
            <TextBlock x:Name="GameActionsHint" Text="Game Actions" VerticalAlignment="Center" Margin="2,0,22,0" IsVisible="{Binding IsGrid}" />
            <TextBlock x:Name="FavoriteHint" Text="Favorite" VerticalAlignment="Center" Margin="2,0,22,0" IsVisible="{Binding IsCarousel}" />
            <Border Classes="key round"><TextBlock Text="Y" /></Border>
            <TextBlock Text="Grid / Carousel" VerticalAlignment="Center" Margin="2,0,22,0" />
            <Border Classes="key"><TextBlock Text="LB" FontSize="11" /></Border>
            <Border Classes="key"><TextBlock Text="RB" FontSize="11" /></Border>
            <TextBlock Text="Library" VerticalAlignment="Center" Margin="2,0,22,0" />
            <Border Classes="key"><TextBlock Text="LT" FontSize="11" /></Border>
            <Border Classes="key"><TextBlock Text="RT" FontSize="11" /></Border>
            <TextBlock Text="Letter" VerticalAlignment="Center" Margin="2,0,22,0" />
            <Border Classes="key"><TextBlock Text="SELECT" FontSize="10" /></Border>
            <TextBlock Text="Settings" VerticalAlignment="Center" Margin="2,0,0,0" />
          </StackPanel>
          <!-- Status messages are hidden; only the progress of a running update (TitleDB, IGDB, logos) shows here. -->
          <TextBlock x:Name="StatusLine" Grid.Column="1" Text="{Binding StatusText}" Classes="muted" FontSize="12"
                     IsVisible="{Binding IsMatchingAll}"
                     HorizontalAlignment="Right" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="20,0,0,0" />
        </Grid>
      </Border>

      <!-- ============================== Details panel (grid view) ============================== -->
      <Border DockPanel.Dock="Right" Width="350" Background="#F2171829" IsVisible="{Binding IsGrid}"
              BorderBrush="{StaticResource SyBorder}" BorderThickness="1,1,0,0" CornerRadius="16,0,0,0" Margin="0,10,0,0">
        <Panel>
          <TextBlock Text="Select a game" Classes="muted" HorizontalAlignment="Center" VerticalAlignment="Center"
                     IsVisible="{Binding !HasSelection}" />
          <ScrollViewer IsVisible="{Binding HasSelection}">
            <StackPanel>
              <Panel Height="150" ClipToBounds="True">
                <Border Background="{Binding SelectedGeneration, Converter={x:Static vm:Converters.GenerationBanner}}" CornerRadius="16,0,0,0" />
                <Image Source="{Binding SelectedKeyArt}" Stretch="UniformToFill" />
                <Border>
                  <Border.Background>
                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                      <GradientStop Offset="0" Color="#10171829" />
                      <GradientStop Offset="0.55" Color="#80171829" />
                      <GradientStop Offset="1" Color="#FF171829" />
                    </LinearGradientBrush>
                  </Border.Background>
                </Border>
              </Panel>

              <StackPanel Margin="18,0,18,18" Spacing="12">
                <Grid ColumnDefinitions="Auto,*">
                  <c:CoverView Width="112" Height="112" Margin="0,-56,14,0" VerticalAlignment="Top"
                               Title="{Binding SelectedTitle}" Generation="{Binding SelectedGeneration}"
                               IsMissing="{Binding SelectedIsMissing}" Image="{Binding SelectedCover}" ShowGenerationBand="False" />
                  <StackPanel Grid.Column="1" VerticalAlignment="Bottom" Spacing="4">
                    <Image Source="{Binding SelectedLogo}" MaxHeight="58" HorizontalAlignment="Left" IsVisible="{Binding HasLogo}"
                           ToolTip.Tip="{Binding SelectedTitle}" />
                    <TextBlock Text="{Binding SelectedTitle}" FontSize="19" FontWeight="Bold" TextWrapping="Wrap"
                               IsVisible="{Binding !HasLogo}" />
                    <TextBlock Text="{Binding DetailsFactsLine}" Classes="muted" FontSize="12" TextWrapping="Wrap" />
                  </StackPanel>
                </Grid>

                <StackPanel Spacing="8">
                  <Grid ColumnDefinitions="*,Auto">
                    <Button x:Name="PlayButton" Classes="primary accent" Command="{Binding PlayCommand}" IsEnabled="{Binding CanPlay}">
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <PathIcon Data="{StaticResource IconPlay}" Width="18" Height="18" />
                        <TextBlock Text="{Binding PlayLabel}" />
                      </StackPanel>
                    </Button>
                    <Button x:Name="FavoriteButton" Grid.Column="1" Classes="subtle fav" Margin="8,0,0,0" Width="48" Padding="0"
                            HorizontalContentAlignment="Center" VerticalAlignment="Stretch"
                            Command="{Binding ToggleFavoriteCommand}" ToolTip.Tip="{Binding FavoriteMenuLabel}">
                      <TextBlock Text="{Binding FavoriteGlyph}" FontSize="22" />
                    </Button>
                  </Grid>
                  <Button x:Name="DetailsGameActionsButton" Classes="subtle" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                          Command="{Binding OpenGameMenuCommand}" Content="Game Actions…" ToolTip.Tip="Launch With, artwork, sort title and more (X, or right-click a cover)" />
                  <TextBlock Text="{Binding RouteText}" Classes="muted" FontSize="12" TextWrapping="Wrap"
                             HorizontalAlignment="Center" TextAlignment="Center" />
                  <!-- EmuReady's PC rating (Settings → Game Info); click to open the game on emuready.com. -->
                  <Button x:Name="EmuReadyButton" Classes="subtle" HorizontalAlignment="Center" Padding="10,4" FontSize="12"
                          IsVisible="{Binding HasEmuReadyText}" IsEnabled="{Binding CanOpenEmuReady}"
                          Command="{Binding OpenEmuReadyCommand}" ToolTip.Tip="{Binding EmuReadyDetails}">
                    <TextBlock Text="{Binding EmuReadyText}" TextWrapping="Wrap" TextAlignment="Center" />
                  </Button>
                </StackPanel>

                <StackPanel Spacing="6" IsVisible="{Binding ShowMissing}">
                  <TextBlock Classes="warning" FontWeight="SemiBold" TextWrapping="Wrap"
                             Text="This game file can't be found. It may have been moved, renamed, or be on a drive that isn't connected." />
                  <Button Classes="subtle" Content="Locate File…" Command="{Binding LocateFileCommand}" />
                </StackPanel>

                <StackPanel Spacing="6" IsVisible="{Binding HasSummary}">
                  <TextBlock Text="ABOUT" Classes="section" />
                  <SelectableTextBlock Text="{Binding SelectedSummary}" TextWrapping="Wrap" LineHeight="20" />
                </StackPanel>

                <Expander Header="Game settings" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                  <StackPanel Spacing="10">
                    <Grid Classes="form" ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto">
                      <TextBlock Grid.Row="0" Text="Generation" />
                      <ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{Binding GenerationOptions}"
                                SelectedItem="{Binding SelectedGenerationOption}" />
                      <TextBlock Grid.Row="1" Text="Emulator" />
                      <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding EmulatorChoices}"
                                SelectedItem="{Binding SelectedEmulatorChoice}" ToolTip.Tip="Which emulator Play uses for this game" />
                      <TextBlock Grid.Row="2" Text="Library" />
                      <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding LibraryChoices}"
                                SelectedItem="{Binding SelectedLibraryChoice}"
                                ToolTip.Tip="Automatic places Arcade Archives titles by name; pick a library to override it" />
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Text="{Binding VersionsText}" VerticalAlignment="Center" Classes="muted" />
                      <Button Grid.Column="1" Classes="subtle" Content="Add Version File…" Command="{Binding AddVersionFileCommand}"
                              ToolTip.Tip="Attach another file of this game (an update, revision or alternate dump)" />
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Text="{Binding MatchStatusText}" Classes="muted" VerticalAlignment="Center"
                                 TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding MatchStatusText}" />
                      <DropDownButton Grid.Column="1" Content="Metadata" Margin="8,0,0,0">
                        <DropDownButton.Flyout>
                          <MenuFlyout Placement="BottomEdgeAlignedRight">
                            <MenuItem Header="{Binding MatchMenuLabel}" Command="{Binding MatchOnIgdbCommand}" />
                            <MenuItem Header="Refresh from IGDB" Command="{Binding RefreshMetadataCommand}" IsEnabled="{Binding IsMatched}" />
                            <MenuItem Header="Remove Match" Command="{Binding RemoveMatchCommand}" IsEnabled="{Binding IsMatched}" />
                            <Separator />
                            <MenuItem Header="Edit Description…" Command="{Binding EditDescriptionCommand}" />
                            <MenuItem Header="Choose Cover…" Command="{Binding ChooseCoverCommand}" />
                            <MenuItem Header="Choose Background…" Command="{Binding ChooseBackgroundCommand}" />
                            <MenuItem Header="Choose Logo…" Command="{Binding ChooseLogoCommand}" />
                            <MenuItem Header="Use Default Artwork" Command="{Binding ResetArtworkCommand}"
                                      ToolTip.Tip="Remove your own cover, background and logo for this game" />
                          </MenuFlyout>
                        </DropDownButton.Flyout>
                      </DropDownButton>
                    </Grid>
                    <SelectableTextBlock Text="{Binding DetailsText}" TextWrapping="Wrap" Classes="muted" FontSize="12" />
                  </StackPanel>
                </Expander>
              </StackPanel>
            </StackPanel>
          </ScrollViewer>
        </Panel>
      </Border>

      <!-- ============================== Covers ============================== -->
      <Grid>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="14" IsVisible="{Binding ShowEmpty}">
          <PathIcon Data="{StaticResource IconGamepad}" Width="56" Height="56" Foreground="{StaticResource SyBorder}" />
          <TextBlock TextAlignment="Center" Classes="muted" FontSize="15" Text="{Binding EmptyText}" />
          <Button Classes="accent" HorizontalAlignment="Center" Command="{Binding AddFolderCommand}" IsVisible="{Binding IsLibraryEmpty}">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <PathIcon Data="{StaticResource IconFolderPlus}" Width="16" Height="16" />
              <TextBlock Text="Add Folder…" />
            </StackPanel>
          </Button>
        </StackPanel>

        <Panel IsVisible="{Binding HasItems}">
          <!-- Grid -->
          <ListBox x:Name="CoverList" IsVisible="{Binding IsGrid}" Background="Transparent" Padding="18,6,10,10"
                   ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel />
              </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:EditionItem">
                <StackPanel Width="190" Spacing="8" ToolTip.Tip="{Binding Tooltip}">
                  <Border Classes="ring" HorizontalAlignment="Center">
                    <Panel>
                      <c:CoverView Width="172" Height="172" Image="{Binding Cover}" ShowGenerationBand="False"
                                   Title="{Binding Title}" Generation="{Binding Generation}" IsMissing="{Binding IsMissing}" />
                      <!-- Favorites wear a star in the corner. -->
                    <Border Classes="favstar" IsVisible="{Binding IsFavorite}"><TextBlock Text="★" /></Border>
                    </Panel>
                  </Border>
                  <TextBlock Classes="card-title" Text="{Binding Title}" TextTrimming="CharacterEllipsis"
                             HorizontalAlignment="Center" MaxWidth="178" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <!-- Carousel -->
          <DockPanel IsVisible="{Binding IsCarousel}">
            <!-- Info band: title, tags, description and Play on the left; the clear logo on the right.
                 A fixed height, so the covers above never move as you browse (logo or not, short or long description). -->
            <Border x:Name="CarouselInfoBand" DockPanel.Dock="Bottom" Height="286" Padding="40,20,40,22"
                    BorderBrush="#33FFFFFF" BorderThickness="0,1,0,0">
              <Border.Background>
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                  <GradientStop Offset="0" Color="#B310111E" />
                  <GradientStop Offset="1" Color="#E610111E" />
                </LinearGradientBrush>
              </Border.Background>
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="10" VerticalAlignment="Top">
                  <!-- The whole name, always: a long one shrinks to fit the line instead of ending in "…". -->
                  <Viewbox x:Name="CarouselTitleFit" Height="46" Stretch="Uniform" StretchDirection="DownOnly"
                           HorizontalAlignment="Left">
                    <TextBlock x:Name="CarouselTitle" Text="{Binding SelectedTitle}" FontSize="34" FontWeight="Bold" />
                  </Viewbox>
                  <StackPanel Orientation="Horizontal" Spacing="10" Height="30">
                    <Border Classes="tag accent" VerticalAlignment="Center" IsVisible="{Binding HasSelection}">
                      <TextBlock Text="{Binding SelectedGenerationLabel}" FontSize="15" />
                    </Border>
                    <ItemsControl ItemsSource="{Binding SelectedTags}" VerticalAlignment="Center">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <StackPanel Orientation="Horizontal" Spacing="10" />
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                          <Border Classes="tag">
                            <TextBlock Text="{Binding}" FontSize="15" />
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                  <TextBlock Text="{Binding CarouselSummary}" FontSize="17" Foreground="#DCDAF0" MaxLines="2" Height="46"
                             TextWrapping="Wrap" TextTrimming="WordEllipsis" MaxWidth="900" HorizontalAlignment="Left" />
                  <StackPanel Spacing="6" Margin="0,6,0,0" HorizontalAlignment="Left">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                      <Button x:Name="CarouselPlayButton" Classes="primary accent" Width="250" MinHeight="58" FontSize="21" CornerRadius="12"
                              Command="{Binding PlayCommand}" IsEnabled="{Binding CanPlay}">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                          <PathIcon Data="{StaticResource IconPlay}" Width="22" Height="22" />
                          <TextBlock Text="{Binding PlayLabel}" />
                        </StackPanel>
                      </Button>
                      <Button x:Name="CarouselFavoriteButton" Classes="subtle fav" Width="58" Height="58" Padding="0" CornerRadius="12"
                              HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Focusable="False"
                              Command="{Binding ToggleFavoriteCommand}" IsVisible="{Binding HasSelection}"
                              ToolTip.Tip="{Binding FavoriteMenuLabel}">
                        <TextBlock Text="{Binding FavoriteGlyph}" FontSize="28" />
                      </Button>
                    </StackPanel>
                    <TextBlock x:Name="CarouselRouteText" Text="{Binding RouteText}" Classes="muted" FontSize="12" MaxWidth="560"
                               TextTrimming="CharacterEllipsis" Margin="4,0,0,0" />
                  </StackPanel>
                </StackPanel>
                <Image Grid.Column="1" Source="{Binding SelectedLogo}" MaxHeight="140" MaxWidth="440" Width="440"
                       Stretch="Uniform" VerticalAlignment="Center" Margin="30,0,0,0" IsVisible="{Binding HasLogo}" />
              </Grid>
            </Border>

            <ListBox x:Name="CarouselList" Background="Transparent" VerticalAlignment="Bottom" Margin="0,0,0,4"
                     ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}"
                     ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                     ScrollViewer.VerticalScrollBarVisibility="Disabled">
              <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                  <!-- Only covers near the screen exist as controls; their images come ready from the cover cache. -->
                  <VirtualizingStackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
              </ListBox.ItemsPanel>
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:EditionItem">
                  <Border Classes="ring" Padding="0" CornerRadius="16">
                    <Panel>
                      <c:CoverView Width="300" Height="300" ToolTip.Tip="{Binding Tooltip}" Image="{Binding Cover}" ShowGenerationBand="False"
                                   Title="{Binding Title}" Generation="{Binding Generation}" IsMissing="{Binding IsMissing}" />
                      <!-- Favorites wear a star in the corner. -->
                    <Border Classes="favstar" IsVisible="{Binding IsFavorite}"><TextBlock Text="★" /></Border>
                    </Panel>
                  </Border>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </DockPanel>

        </Panel>
      </Grid>
    </DockPanel>

    <!-- Letter jump (Up/Down in the carousel, LT/RT, Page Up/Down): the letter shows briefly. -->
    <Border x:Name="LetterBadge" IsVisible="{Binding ShowJumpLetter}" IsHitTestVisible="False"
            HorizontalAlignment="Center" VerticalAlignment="Center" Width="150" Height="150" CornerRadius="28"
            Background="#E6171829" BorderBrush="{StaticResource SyAccent}" BorderThickness="2">
      <TextBlock Text="{Binding JumpLetter}" FontSize="84" FontWeight="Black" Foreground="{StaticResource SyAccent}"
                 HorizontalAlignment="Center" VerticalAlignment="Center" />
    </Border>


    <!-- ============================== Settings page ==============================
         Full screen, the same in the grid and the carousel. Sections on the left, their settings on the right.
         Controller and keyboard: Up/Down move, A/Enter/Right go in or change, Left/Right change a choice,
         B/Esc go back one step. Mouse: click. -->
    <Border x:Name="SettingsPage" IsVisible="{Binding IsSettingsOpen}" Focusable="True"
            Background="{StaticResource SyBackground}">
      <Border.Styles>
        <Style Selector="ListBox.settings">
          <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ListBox.settings ListBoxItem">
          <Setter Property="CornerRadius" Value="12" />
          <Setter Property="Margin" Value="0,2" />
          <Setter Property="FocusAdorner" Value="{x:Null}" />
        </Style>
        <Style Selector="ListBox.settings ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
          <Setter Property="Background" Value="#14FFFFFF" />
        </Style>
        <!-- Sections: the chosen one is lit; brighter while the D-pad is on the sections. -->
        <Style Selector="ListBox#SettingsSectionList ListBoxItem">
          <Setter Property="Padding" Value="16,14" />
        </Style>
        <Style Selector="ListBox#SettingsSectionList ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
          <Setter Property="Background" Value="{StaticResource SyChip}" />
        </Style>
        <Style Selector="ListBox#SettingsSectionList:not(.inrows) ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
          <Setter Property="Background" Value="{StaticResource SyAccent}" />
        </Style>
        <Style Selector="ListBox#SettingsSectionList:not(.inrows) ListBoxItem:selected TextBlock">
          <Setter Property="Foreground" Value="{StaticResource SyOnAccent}" />
        </Style>
        <Style Selector="ListBox#SettingsSectionList:not(.inrows) ListBoxItem:selected PathIcon">
          <Setter Property="Foreground" Value="{StaticResource SyOnAccent}" />
        </Style>
        <!-- Settings: the current one is outlined while the D-pad is on them. -->
        <Style Selector="ListBox#SettingsRowList ListBoxItem">
          <Setter Property="Padding" Value="20,14" />
          <Setter Property="BorderThickness" Value="2" />
          <Setter Property="BorderBrush" Value="Transparent" />
          <Setter Property="Background" Value="{StaticResource SySurface}" />
        </Style>
        <Style Selector="ListBox#SettingsRowList ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
          <Setter Property="Background" Value="{StaticResource SySurface}" />
        </Style>
        <Style Selector="ListBox#SettingsRowList.inrows ListBoxItem:selected">
          <Setter Property="BorderBrush" Value="{StaticResource SyAccent}" />
        </Style>
        <Style Selector="ListBox#SettingsRowList.inrows ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
          <Setter Property="Background" Value="{StaticResource SySurface2}" />
        </Style>
        <!-- On/off switch. -->
        <Style Selector="Border.switch">
          <Setter Property="Width" Value="54" />
          <Setter Property="Height" Value="30" />
          <Setter Property="CornerRadius" Value="15" />
          <Setter Property="Padding" Value="4" />
          <Setter Property="Background" Value="{StaticResource SySurface2}" />
          <Setter Property="BorderBrush" Value="{StaticResource SyBorder}" />
          <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="Border.switch.on">
          <Setter Property="Background" Value="{StaticResource SyAccent}" />
          <Setter Property="BorderBrush" Value="{StaticResource SyAccent}" />
        </Style>
        <Style Selector="Border.switch > Border.knob">
          <Setter Property="Width" Value="20" />
          <Setter Property="Height" Value="20" />
          <Setter Property="CornerRadius" Value="10" />
          <Setter Property="Background" Value="{StaticResource SyMuted}" />
          <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>
        <Style Selector="Border.switch.on > Border.knob">
          <Setter Property="Background" Value="{StaticResource SyOnAccent}" />
          <Setter Property="HorizontalAlignment" Value="Right" />
        </Style>
        <Style Selector="Button.arrow">
          <Setter Property="Width" Value="38" />
          <Setter Property="Height" Value="38" />
          <Setter Property="Padding" Value="0" />
          <Setter Property="CornerRadius" Value="19" />
          <Setter Property="HorizontalContentAlignment" Value="Center" />
          <Setter Property="VerticalContentAlignment" Value="Center" />
          <Setter Property="FontSize" Value="20" />
          <Setter Property="Focusable" Value="False" />
        </Style>
      </Border.Styles>
      <DockPanel>
        <Border DockPanel.Dock="Top" Padding="40,20,28,16" BorderBrush="#2AFFFFFF" BorderThickness="0,0,0,1">
          <Grid ColumnDefinitions="Auto,*,Auto">
            <PathIcon Data="{StaticResource IconSettings}" Width="26" Height="26" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="Settings" FontSize="28" FontWeight="Bold" Margin="14,0" VerticalAlignment="Center" />
            <Button x:Name="SettingsCloseButton" Grid.Column="2" Classes="subtle" Content="Close" Padding="20,8" Focusable="False"
                    Command="{Binding CloseSettingsCommand}" ToolTip.Tip="Close Settings (B, Esc or Select)" />
          </Grid>
        </Border>
        <Border DockPanel.Dock="Bottom" Padding="40,12" BorderBrush="#2AFFFFFF" BorderThickness="0,1,0,0">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Border Classes="key"><TextBlock Text="↑↓" /></Border>
            <TextBlock Text="Move" VerticalAlignment="Center" Margin="2,0,20,0" />
            <Border Classes="key round"><TextBlock Text="A" /></Border>
            <TextBlock Text="Select" VerticalAlignment="Center" Margin="2,0,20,0" />
            <Border Classes="key"><TextBlock Text="←→" /></Border>
            <TextBlock Text="Change" VerticalAlignment="Center" Margin="2,0,20,0" />
            <Border Classes="key round"><TextBlock Text="B" /></Border>
            <TextBlock Text="{Binding SettingsBackLabel}" VerticalAlignment="Center" Margin="2,0,0,0" />
          </StackPanel>
        </Border>
        <Grid ColumnDefinitions="300,*" Margin="28,22,40,16">
          <ListBox x:Name="SettingsSectionList" Classes="settings" Classes.inrows="{Binding SettingsInRows}"
                   ItemsSource="{Binding SettingsSections}" SelectedIndex="{Binding SettingsSectionIndex}"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:SettingSection">
                <StackPanel Orientation="Horizontal" Spacing="14">
                  <PathIcon Data="{Binding IconKey, Converter={x:Static vm:Converters.IconGeometry}}" Width="22" Height="22" />
                  <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <DockPanel Grid.Column="1" Margin="32,0,0,0">
            <StackPanel DockPanel.Dock="Top" Margin="4,2,0,18" Spacing="4">
              <TextBlock Text="{Binding SettingsSection.Title}" FontSize="24" FontWeight="Bold" />
              <TextBlock Text="{Binding SettingsSection.Description}" Classes="muted" TextWrapping="Wrap" />
            </StackPanel>
            <ListBox x:Name="SettingsRowList" Classes="settings" Classes.inrows="{Binding SettingsInRows}"
                     ItemsSource="{Binding SettingsRows}" SelectedIndex="{Binding SettingsRowIndex, Mode=OneWay}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:SettingRow">
                  <Grid ColumnDefinitions="*,Auto" Opacity="{Binding Opacity}" Background="Transparent">
                    <StackPanel VerticalAlignment="Center" Spacing="3" Margin="0,0,24,0">
                      <TextBlock Text="{Binding Label}" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" />
                      <TextBlock Text="{Binding Description}" Classes="muted" FontSize="13" TextWrapping="Wrap"
                                 IsVisible="{Binding HasDescription}" />
                    </StackPanel>
                    <Panel Grid.Column="1" VerticalAlignment="Center">
                      <Border Classes="switch" Classes.on="{Binding On}" IsVisible="{Binding IsToggle}">
                        <Border Classes="knob" />
                      </Border>
                      <StackPanel Orientation="Horizontal" Spacing="10" IsVisible="{Binding IsChoice}">
                        <Button Classes="subtle arrow" Content="‹" Click="SettingPrevious_Click" ToolTip.Tip="Previous (Left)" />
                        <TextBlock Text="{Binding ValueText}" FontSize="16" MinWidth="190" TextAlignment="Center"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="300" />
                        <Button Classes="subtle arrow" Content="›" Click="SettingNext_Click" ToolTip.Tip="Next (Right)" />
                      </StackPanel>
                      <StackPanel Orientation="Horizontal" Spacing="12" IsVisible="{Binding IsAction}">
                        <TextBlock Text="{Binding ValueText}" Classes="muted" FontSize="13" VerticalAlignment="Center"
                                   MaxWidth="360" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="›" FontSize="22" VerticalAlignment="Center" />
                      </StackPanel>
                      <TextBlock Text="{Binding ValueText}" FontSize="15" VerticalAlignment="Center" MaxWidth="460"
                                 TextTrimming="CharacterEllipsis" IsVisible="{Binding !Selectable}" />
                    </Panel>
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </DockPanel>
        </Grid>
      </DockPanel>
    </Border>

    <!-- The on-screen menu: Game Actions (X, the button, right-click) and Settings (Select/Back, the gear).
         D-pad or arrows to move, A or Enter to choose, B or Esc to go back. -->
    <Border x:Name="MenuOverlay" IsVisible="{Binding IsMenuOpen}" Background="#A6000000">
      <Border x:Name="MenuPanel" Width="520" MaxHeight="720" HorizontalAlignment="Center" VerticalAlignment="Center"
              Background="{StaticResource SySurface}" BorderBrush="{StaticResource SyBorder}" BorderThickness="1"
              CornerRadius="18" Padding="14,14,14,10" BoxShadow="0 18 50 0 #80000000">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="{Binding MenuTitle}" FontSize="21" FontWeight="Bold" Margin="14,4,14,10"
                     TextTrimming="CharacterEllipsis" />
          <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="18" Margin="14,10,14,2">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Border Classes="key"><TextBlock Text="A" /></Border>
              <TextBlock Text="Choose" Classes="muted" VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Border Classes="key"><TextBlock Text="B" /></Border>
              <TextBlock Text="{Binding MenuBackLabel}" Classes="muted" VerticalAlignment="Center" />
            </StackPanel>
          </StackPanel>
          <ListBox x:Name="MenuList" ItemsSource="{Binding MenuItems}" Background="Transparent" SelectionMode="Single"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.Styles>
              <Style Selector="ListBoxItem">
                <Setter Property="Padding" Value="14,11" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="Margin" Value="0,1" />
              </Style>
              <Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="Background" Value="{StaticResource SyAccent}" />
              </Style>
              <Style Selector="ListBoxItem:selected TextBlock">
                <Setter Property="Foreground" Value="{StaticResource SyOnAccent}" />
              </Style>
            </ListBox.Styles>
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:MenuEntry">
                <Grid ColumnDefinitions="26,*,Auto" Opacity="{Binding Opacity}" Background="Transparent">
                  <TextBlock Text="✓" FontWeight="Bold" FontSize="16" IsVisible="{Binding IsChecked}" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="1" Text="{Binding Label}" FontSize="16" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                  <TextBlock Grid.Column="2" Text="›" FontSize="20" IsVisible="{Binding HasPage}" VerticalAlignment="Center" Margin="8,0,0,0" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>
    </Border>
  </Panel>
</Window>
