<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SDock.App.ViewModels"
        x:Class="SDock.App.Views.MatchWindow"
        x:DataType="vm:MatchViewModel"
        Title="Match on IGDB"
        Width="760" Height="620" MinWidth="560" MinHeight="420"
        WindowStartupLocation="CenterOwner">
  <DockPanel Margin="18">
    <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="0,0,0,10">
      <TextBlock Text="{Binding Heading}" FontSize="17" FontWeight="Bold" TextWrapping="Wrap" />
      <TextBlock Text="{Binding PlatformNote}" Classes="muted" />
      <Grid ColumnDefinitions="*,Auto">
        <TextBox x:Name="QueryBox" Text="{Binding Query}" PlaceholderText="Search IGDB" />
        <Button Grid.Column="1" Content="Search" Command="{Binding SearchCommand}" Margin="8,0,0,0" IsDefault="True" />
      </Grid>
      <CheckBox Content="Search all platforms" IsChecked="{Binding AnyPlatform}" />
    </StackPanel>

    <StackPanel DockPanel.Dock="Bottom" Spacing="8" Margin="0,10,0,0">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <TextBlock Text="Or paste an IGDB link or ID:" VerticalAlignment="Center" Margin="0,0,8,0" />
        <TextBox Grid.Column="1" Text="{Binding Reference}" PlaceholderText="https://www.igdb.com/games/..." />
        <Button Grid.Column="2" Content="Look Up" Command="{Binding LookUpCommand}" Margin="8,0,0,0" />
      </Grid>
      <TextBlock Text="{Binding Status}" Classes="muted" TextWrapping="Wrap" />
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
        <Button Content="Match" Classes="accent" MinWidth="90" HorizontalContentAlignment="Center" Command="{Binding MatchCommand}" />
        <Button Content="Cancel" MinWidth="90" HorizontalContentAlignment="Center" Command="{Binding CancelCommand}" IsCancel="True" />
      </StackPanel>
    </StackPanel>

    <Grid>
      <ProgressBar IsIndeterminate="True" VerticalAlignment="Top" IsVisible="{Binding IsBusy}" />
      <ListBox x:Name="ResultList" ItemsSource="{Binding Results}" SelectedItem="{Binding Selected}" Margin="0,6,0,0">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:MatchCandidate">
            <Grid ColumnDefinitions="64,*" Margin="0,3">
              <Border Width="54" Height="76" CornerRadius="4" ClipToBounds="True" Background="#22FFFFFF">
                <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
              </Border>
              <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock Text="{Binding Detail}" Classes="muted" FontSize="12" TextWrapping="Wrap" />
              </StackPanel>
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Grid>
  </DockPanel>
</Window>
