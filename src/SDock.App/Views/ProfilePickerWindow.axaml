<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SDock.App.ViewModels"
        x:Class="SDock.App.Views.ProfilePickerWindow"
        x:DataType="vm:ProfilePickerViewModel"
        Title="Choose Emulator"
        Width="600" Height="460" MinWidth="460" MinHeight="340"
        WindowStartupLocation="CenterOwner">
  <DockPanel Margin="18">
    <StackPanel DockPanel.Dock="Top" Spacing="6" Margin="0,0,0,12">
      <TextBlock Text="{Binding Heading}" FontSize="17" FontWeight="Bold" TextWrapping="Wrap" />
      <TextBlock Text="{Binding Explanation}" Classes="muted" TextWrapping="Wrap" />
    </StackPanel>

    <StackPanel DockPanel.Dock="Bottom" Spacing="8" Margin="0,12,0,0">
      <CheckBox Content="Always use this emulator for this game" IsChecked="{Binding RememberForGame}" IsVisible="{Binding ShowRemember}" />
      <CheckBox Content="{Binding MakeDefaultLabel}" IsChecked="{Binding MakeDefault}"
                IsVisible="{Binding ShowMakeDefault}" IsEnabled="{Binding CanMakeDefault}" />
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,6,0,0">
        <Button Content="Play" Classes="accent" MinWidth="90" HorizontalContentAlignment="Center" Command="{Binding PlayCommand}" IsDefault="True" />
        <Button Content="Cancel" MinWidth="90" HorizontalContentAlignment="Center" Command="{Binding CancelCommand}" IsCancel="True" />
      </StackPanel>
    </StackPanel>

    <ListBox x:Name="ProfileList" ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}">
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="vm:PickerItem">
          <StackPanel Spacing="2" Margin="0,3" Opacity="{Binding IsCompatible, Converter={x:Static vm:Converters.CompatibleOpacity}}">
            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
            <TextBlock Text="{Binding Detail}" Classes="muted" FontSize="12" TextTrimming="CharacterEllipsis" />
          </StackPanel>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </DockPanel>
</Window>
