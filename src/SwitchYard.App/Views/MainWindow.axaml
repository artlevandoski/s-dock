<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SwitchYard.App.ViewModels"
        xmlns:c="using:SwitchYard.App.Controls"
        x:Class="SwitchYard.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="Switch Yard"
        Icon="avares://SwitchYard/Assets/switchyard.ico"
        Width="1180" Height="780" MinWidth="820" MinHeight="560"
        WindowStartupLocation="CenterScreen">
  <Window.KeyBindings>
    <KeyBinding Gesture="Ctrl+O" Command="{Binding AddFolderCommand}" />
    <KeyBinding Gesture="Ctrl+E" Command="{Binding EmulatorSettingsCommand}" />
    <KeyBinding Gesture="Ctrl+Tab" Command="{Binding NextLibraryCommand}" />
    <KeyBinding Gesture="Ctrl+Shift+Tab" Command="{Binding PreviousLibraryCommand}" />
    <KeyBinding Gesture="Ctrl+G" Command="{Binding ToggleViewCommand}" />
  </Window.KeyBindings>

  <Window.Styles>
    <!-- Carousel: the selected cover is ~18% larger than its neighbours, with a short animation. -->
    <Style Selector="ListBox#CarouselList ListBoxItem">
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="22,36" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="RenderTransformOrigin" Value="50%,50%" />
      <Setter Property="RenderTransform" Value="scale(1)" />
      <Setter Property="Opacity" Value="0.7" />
      <Setter Property="Transitions">
        <Transitions>
          <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.16" />
          <DoubleTransition Property="Opacity" Duration="0:0:0.16" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="ListBox#CarouselList ListBoxItem:selected">
      <Setter Property="RenderTransform" Value="scale(1.18)" />
      <Setter Property="Opacity" Value="1" />
      <Setter Property="ZIndex" Value="1" />
    </Style>
    <Style Selector="ListBox#CarouselList ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ListBox#CarouselList ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ListBox#CarouselList ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ListBox#CarouselList ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
  </Window.Styles>

  <DockPanel>
    <Menu DockPanel.Dock="Top">
      <MenuItem Header="_Library">
        <MenuItem Header="_Add Folder…" InputGesture="Ctrl+O" Command="{Binding AddFolderCommand}" />
        <Separator />
        <MenuItem Header="_Next Library" InputGesture="Ctrl+Tab" Command="{Binding NextLibraryCommand}" />
        <MenuItem Header="_Grid / Carousel" InputGesture="Ctrl+G" Command="{Binding ToggleViewCommand}" />
        <Separator />
        <MenuItem Header="Open _Data Folder" Command="{Binding OpenDataFolderCommand}" ToolTip.Tip="{Binding DataFolderTip}" />
        <Separator />
        <MenuItem Header="_Quit" Click="Quit_Click" />
      </MenuItem>
      <MenuItem Header="_Emulator">
        <MenuItem Header="Emulator _Settings…" InputGesture="Ctrl+E" Command="{Binding EmulatorSettingsCommand}" />
        <Separator />
        <MenuItem Header="Open Emulators _Folder" Command="{Binding OpenEmulatorsFolderCommand}" />
      </MenuItem>
      <MenuItem Header="_Metadata">
        <MenuItem Header="_Match Unmatched Games" Command="{Binding MatchUnmatchedCommand}" IsEnabled="{Binding !IsMatchingAll}" />
        <MenuItem Header="_Cancel Matching" Command="{Binding CancelMatchingCommand}" IsVisible="{Binding IsMatchingAll}" />
        <MenuItem Header="Get Missing _Logos" Command="{Binding GetMissingLogosCommand}"
                  ToolTip.Tip="Fetch logos (IGDB first, then SteamGridDB) for matched games that don't have one" />
        <Separator />
        <MenuItem Header="Metadata _Settings…" Command="{Binding IgdbSettingsCommand}" />
      </MenuItem>
    </Menu>

    <!-- Toolbar: actions on the left, library tabs in the middle, view toggle on the right -->
    <Border DockPanel.Dock="Top" Padding="8,4" BorderBrush="#30FFFFFF" BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <Button Content="Add Folder…" Command="{Binding AddFolderCommand}" />
          <Button Content="Emulator Settings…" Command="{Binding EmulatorSettingsCommand}" />
        </StackPanel>
        <TabStrip Grid.Column="1" HorizontalAlignment="Center" ItemsSource="{Binding LibraryTabs}"
                  SelectedItem="{Binding SelectedLibraryTab}" ToolTip.Tip="Switch library (Ctrl+Tab)">
          <TabStrip.ItemTemplate>
            <DataTemplate x:DataType="vm:LibraryTab">
              <TextBlock Text="{Binding Header}" />
            </DataTemplate>
          </TabStrip.ItemTemplate>
        </TabStrip>
        <Button Grid.Column="2" Content="{Binding ViewToggleLabel}" Command="{Binding ToggleViewCommand}"
                ToolTip.Tip="Switch between grid and carousel (Ctrl+G)" />
      </Grid>
    </Border>

    <Border DockPanel.Dock="Bottom" Padding="10,4" BorderBrush="#30FFFFFF" BorderThickness="0,1,0,0">
      <TextBlock x:Name="StatusLine" Text="{Binding StatusText}" Classes="muted" />
    </Border>

    <!-- Details panel -->
    <Border DockPanel.Dock="Right" Width="330" BorderBrush="#30FFFFFF" BorderThickness="1,0,0,0">
      <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Bottom" Spacing="6">
          <TextBlock Text="{Binding RouteText}" Classes="muted" TextWrapping="Wrap" HorizontalAlignment="Center"
                     TextAlignment="Center" IsVisible="{Binding HasSelection}" />
          <Button x:Name="PlayButton" Classes="primary accent"
                  Content="{Binding PlayLabel}" Command="{Binding PlayCommand}" IsEnabled="{Binding CanPlay}" />
          <Grid ColumnDefinitions="*,6,*">
            <Button Content="Launch With…" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                    Command="{Binding LaunchWithCommand}" IsEnabled="{Binding CanPlay}"
                    ToolTip.Tip="Pick an emulator for this launch only" />
            <Button Grid.Column="2" Content="Play Version…" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                    Command="{Binding PlayVersionCommand}" IsEnabled="{Binding CanPlay}"
                    ToolTip.Tip="Launch another file of this game, or choose its main file" />
          </Grid>
        </StackPanel>
        <ScrollViewer>
          <StackPanel Spacing="10">
            <c:CoverView Width="120" Height="170" HorizontalAlignment="Center" IsVisible="{Binding HasSelection}"
                         Title="{Binding SelectedTitle}" Generation="{Binding SelectedGeneration}"
                         IsMissing="{Binding SelectedIsMissing}" Image="{Binding SelectedCover}" />
            <StackPanel Spacing="2">
              <!-- Clear logo in place of the name when the game has one -->
              <Image Source="{Binding SelectedLogo}" MaxHeight="72" HorizontalAlignment="Left" IsVisible="{Binding HasLogo}"
                     ToolTip.Tip="{Binding SelectedTitle}" Margin="0,2,0,4" />
              <TextBlock Text="{Binding SelectedTitle}" FontSize="20" FontWeight="Bold" TextWrapping="Wrap"
                         IsVisible="{Binding !HasLogo}" />
              <TextBlock Text="{Binding SelectedFactsLine}" Classes="muted" TextWrapping="Wrap" IsVisible="{Binding IsMatched}" />
            </StackPanel>
            <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding HasSelection}">
              <TextBlock Text="{Binding MatchStatusText}" Classes="muted" VerticalAlignment="Center"
                         TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding MatchStatusText}" />
              <DropDownButton Grid.Column="1" Content="Metadata" Margin="8,0,0,0">
                <DropDownButton.Flyout>
                  <MenuFlyout Placement="BottomEdgeAlignedRight">
                    <MenuItem Header="{Binding MatchMenuLabel}" Command="{Binding MatchOnIgdbCommand}" />
                    <MenuItem Header="Refresh from IGDB" Command="{Binding RefreshMetadataCommand}" IsEnabled="{Binding IsMatched}" />
                    <MenuItem Header="Remove Match" Command="{Binding RemoveMatchCommand}" IsEnabled="{Binding IsMatched}" />
                    <Separator />
                    <MenuItem Header="Edit Description…" Command="{Binding EditDescriptionCommand}" />
                    <MenuItem Header="Choose Background…" Command="{Binding ChooseBackgroundCommand}"
                              ToolTip.Tip="Pick the image shown behind the carousel" />
                    <MenuItem Header="Choose Logo…" Command="{Binding ChooseLogoCommand}"
                              ToolTip.Tip="Pick the clear logo shown in place of the game name" />
                    <MenuItem Header="Set Cover Image…" Command="{Binding SetCoverCommand}" />
                    <MenuItem Header="Use Default Artwork" Command="{Binding ResetArtworkCommand}"
                              ToolTip.Tip="Remove your own cover, background and logo for this game" />
                  </MenuFlyout>
                </DropDownButton.Flyout>
              </DropDownButton>
            </Grid>
            <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto" IsVisible="{Binding HasSelection}">
              <Grid.Styles>
                <Style Selector="Grid > TextBlock">
                  <Setter Property="VerticalAlignment" Value="Center" />
                  <Setter Property="Margin" Value="0,0,8,0" />
                </Style>
                <Style Selector="Grid > ComboBox">
                  <Setter Property="HorizontalAlignment" Value="Stretch" />
                  <Setter Property="Margin" Value="0,3" />
                </Style>
              </Grid.Styles>
              <TextBlock Grid.Row="0" Text="Generation:" />
              <ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{Binding GenerationOptions}"
                        SelectedItem="{Binding SelectedGenerationOption}" />
              <TextBlock Grid.Row="1" Text="Emulator:" />
              <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding EmulatorChoices}"
                        SelectedItem="{Binding SelectedEmulatorChoice}" ToolTip.Tip="Which emulator Play uses for this game" />
              <TextBlock Grid.Row="2" Text="Library:" />
              <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding LibraryChoices}"
                        SelectedItem="{Binding SelectedLibraryChoice}"
                        ToolTip.Tip="Automatic places Arcade Archives titles by name; pick a library to override it" />
            </Grid>
            <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding HasSelection}">
              <TextBlock Text="{Binding VersionsText}" VerticalAlignment="Center" Classes="muted" />
              <Button Grid.Column="1" Content="Add Version File…" Command="{Binding AddVersionFileCommand}"
                      ToolTip.Tip="Attach another file of this game (an update, revision or alternate dump)" />
            </Grid>
            <SelectableTextBlock Text="{Binding SelectedSummary}" TextWrapping="Wrap" IsVisible="{Binding HasSummary}" />
            <SelectableTextBlock Text="{Binding DetailsText}" TextWrapping="Wrap" Classes="muted" FontSize="12" />
            <TextBlock Classes="warning" FontWeight="Bold" TextWrapping="Wrap" IsVisible="{Binding ShowMissing}"
                       Text="This game file can't be found. It may have been moved, renamed, or be on a drive that isn't connected." />
            <Button Content="Locate File…" Command="{Binding LocateFileCommand}" IsVisible="{Binding ShowMissing}" />
          </StackPanel>
        </ScrollViewer>
      </DockPanel>
    </Border>

    <!-- Search and filters for the current library -->
    <Border DockPanel.Dock="Top" Padding="10,8" BorderBrush="#18FFFFFF" BorderThickness="0,0,0,1">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <TextBox x:Name="SearchBox" Width="260" Text="{Binding SearchText}" PlaceholderText="Search this library (Ctrl+F)" />
        <ComboBox ItemsSource="{Binding GenerationFilterOptions}" SelectedItem="{Binding GenerationFilter}" MinWidth="150" />
        <ComboBox ItemsSource="{Binding SeriesFilterOptions}" SelectedItem="{Binding SeriesFilter}" MinWidth="160"
                  IsVisible="{Binding IsArcade}" />
        <CheckBox Content="Include ACA NEOGEO" IsChecked="{Binding IncludeAcaNeogeo}" IsVisible="{Binding IsArcade}"
                  ToolTip.Tip="Show ACA NEOGEO titles here instead of in Main Library" />
        <Button Content="Clear" Command="{Binding ClearFiltersCommand}" IsVisible="{Binding HasActiveFilters}" />
      </StackPanel>
    </Border>

    <!-- Covers: grid or carousel, sharing one selection -->
    <Grid>
      <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" Classes="muted"
                 FontSize="16" Text="{Binding EmptyText}" IsVisible="{Binding ShowEmpty}" />
      <Panel IsVisible="{Binding HasItems}">
        <ListBox x:Name="CoverList" IsVisible="{Binding IsGrid}" Background="Transparent" Padding="8"
                 ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
          <ListBox.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel />
            </ItemsPanelTemplate>
          </ListBox.ItemsPanel>
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:EditionItem">
              <StackPanel Width="156" Spacing="6" ToolTip.Tip="{Binding Tooltip}">
                <c:CoverView Width="150" Height="212" HorizontalAlignment="Center" Image="{Binding Cover}" ShowGenerationBand="False"
                             Title="{Binding Title}" Generation="{Binding Generation}" IsMissing="{Binding IsMissing}" />
                <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" HorizontalAlignment="Center" MaxWidth="150" />
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <!-- Landscape key art of the selected game, dimmed behind the carousel -->
        <Image Source="{Binding SelectedKeyArt}" Stretch="UniformToFill" Opacity="0.22" IsVisible="{Binding IsCarousel}"
               IsHitTestVisible="False" />
        <DockPanel IsVisible="{Binding IsCarousel}">
          <StackPanel DockPanel.Dock="Bottom" Spacing="4" Margin="20,0,20,18" HorizontalAlignment="Center">
            <Image Source="{Binding SelectedLogo}" MaxHeight="90" MaxWidth="420" IsVisible="{Binding HasLogo}"
                   HorizontalAlignment="Center" />
            <TextBlock Text="{Binding SelectedTitle}" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center"
                       TextAlignment="Center" TextWrapping="Wrap" IsVisible="{Binding !HasLogo}" />
            <TextBlock Text="{Binding CarouselSubtitle}" Classes="muted" HorizontalAlignment="Center" />
            <TextBlock Text="← → browse  ·  Enter play  ·  controller: D-pad, A to play, LB/RB library, Y view"
                       Classes="muted" FontSize="12" HorizontalAlignment="Center" Margin="0,6,0,0" />
          </StackPanel>
          <ListBox x:Name="CarouselList" Background="Transparent" VerticalAlignment="Center"
                   ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}"
                   ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                   ScrollViewer.VerticalScrollBarVisibility="Disabled">
            <ListBox.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" />
              </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:EditionItem">
                <c:CoverView Width="200" Height="283" ToolTip.Tip="{Binding Tooltip}" Image="{Binding Cover}" ShowGenerationBand="False"
                             Title="{Binding Title}" Generation="{Binding Generation}" IsMissing="{Binding IsMissing}" />
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>

        <Panel.ContextMenu>
          <ContextMenu>
            <MenuItem Header="Play" Command="{Binding PlayCommand}" IsEnabled="{Binding CanPlay}" />
            <MenuItem Header="Launch With…" Command="{Binding LaunchWithCommand}" IsEnabled="{Binding CanPlay}" />
            <MenuItem Header="Play Version…" Command="{Binding PlayVersionCommand}" IsEnabled="{Binding CanPlay}" />
            <Separator />
            <MenuItem Header="Add Version File…" Command="{Binding AddVersionFileCommand}" />
            <MenuItem Header="{Binding MatchMenuLabel}" Command="{Binding MatchOnIgdbCommand}" />
            <MenuItem Header="Choose Background…" Command="{Binding ChooseBackgroundCommand}" />
            <MenuItem Header="Choose Logo…" Command="{Binding ChooseLogoCommand}" />
          </ContextMenu>
        </Panel.ContextMenu>
      </Panel>
    </Grid>
  </DockPanel>
</Window>
