<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SwitchYard.App.ViewModels"
        x:Class="SwitchYard.App.Views.IgdbSettingsWindow"
        x:DataType="vm:IgdbSettingsViewModel"
        Title="IGDB Settings"
        Width="640" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner">
  <StackPanel Margin="20" Spacing="12">
    <TextBlock Text="IGDB artwork and descriptions" FontSize="17" FontWeight="Bold" />
    <TextBlock Text="{Binding Explanation}" TextWrapping="Wrap" />
    <StackPanel Orientation="Horizontal" Spacing="8">
      <Button Content="Open Twitch developer console" Command="{Binding OpenTwitchConsoleCommand}" />
      <Button Content="IGDB setup guide" Command="{Binding OpenIgdbDocsCommand}" />
    </StackPanel>
    <Grid ColumnDefinitions="120,*" RowDefinitions="Auto,Auto">
      <TextBlock Text="Client ID:" VerticalAlignment="Center" />
      <TextBox Grid.Column="1" Text="{Binding ClientId}" Margin="0,4" FontFamily="Consolas, monospace" />
      <TextBlock Grid.Row="1" Text="Client Secret:" VerticalAlignment="Center" />
      <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding ClientSecret}" PasswordChar="*" Margin="0,4"
               FontFamily="Consolas, monospace" />
    </Grid>
    <TextBlock Text="{Binding StorageNote}" Classes="muted" TextWrapping="Wrap" FontSize="12" />
    <SelectableTextBlock Text="{Binding Status}" TextWrapping="Wrap" Classes.warning="{Binding StatusIsError}" />
    <Grid ColumnDefinitions="Auto,*,Auto,Auto">
      <Button Content="Test Connection" Command="{Binding TestCommand}" />
      <Button Grid.Column="2" Content="Save" Classes="accent" MinWidth="90" HorizontalContentAlignment="Center"
              Command="{Binding SaveCommand}" Margin="0,0,8,0" />
      <Button Grid.Column="3" Content="Cancel" MinWidth="90" HorizontalContentAlignment="Center"
              Command="{Binding CancelCommand}" IsCancel="True" />
    </Grid>
  </StackPanel>
</Window>
