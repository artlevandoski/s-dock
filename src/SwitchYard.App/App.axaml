<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="SwitchYard.App.App"
             Name="Switch Yard"
             RequestedThemeVariant="Dark">
  <Application.Resources>
    <!-- Switch Yard palette: deep navy surfaces with a lavender accent (from the carousel mockup) -->
    <Color x:Key="SyBackgroundColor">#10111E</Color>
    <Color x:Key="SySurfaceColor">#171829</Color>
    <Color x:Key="SySurface2Color">#222439</Color>
    <Color x:Key="SyBorderColor">#33365A</Color>
    <Color x:Key="SyTextColor">#F1F0FA</Color>
    <Color x:Key="SyMutedColor">#A6A8C6</Color>
    <Color x:Key="SyAccentColor">#C3A6FF</Color>
    <Color x:Key="SyAccentHoverColor">#D3BEFF</Color>
    <Color x:Key="SyAccentPressedColor">#AA8AF0</Color>
    <Color x:Key="SyOnAccentColor">#1A1430</Color>
    <Color x:Key="SyAccentGlowColor">#99B996FF</Color>

    <SolidColorBrush x:Key="SyBackground" Color="{StaticResource SyBackgroundColor}" />
    <SolidColorBrush x:Key="SySurface" Color="{StaticResource SySurfaceColor}" />
    <SolidColorBrush x:Key="SySurface2" Color="{StaticResource SySurface2Color}" />
    <SolidColorBrush x:Key="SyBorder" Color="{StaticResource SyBorderColor}" />
    <SolidColorBrush x:Key="SyText" Color="{StaticResource SyTextColor}" />
    <SolidColorBrush x:Key="SyMuted" Color="{StaticResource SyMutedColor}" />
    <SolidColorBrush x:Key="SyAccent" Color="{StaticResource SyAccentColor}" />
    <SolidColorBrush x:Key="SyAccentHover" Color="{StaticResource SyAccentHoverColor}" />
    <SolidColorBrush x:Key="SyAccentPressed" Color="{StaticResource SyAccentPressedColor}" />
    <SolidColorBrush x:Key="SyOnAccent" Color="{StaticResource SyOnAccentColor}" />
    <SolidColorBrush x:Key="SyGlass" Color="#B3171829" />
    <SolidColorBrush x:Key="SyChip" Color="#3A2F6B" />

    <!-- Icons (Material Design paths, Apache 2.0) -->
    <StreamGeometry x:Key="IconGrid">M3,11H11V3H3M3,21H11V13H3M13,21H21V13H13M13,3V11H21V3</StreamGeometry>
    <StreamGeometry x:Key="IconCarousel">M7,19H17V4H7M2,17H6V6H2M18,6V17H22V6H18Z</StreamGeometry>
    <StreamGeometry x:Key="IconSearch">M9.5,3A6.5,6.5 0 0,1 16,9.5C16,11.11 15.41,12.59 14.44,13.73L14.71,14H15.5L20.5,19L19,20.5L14,15.5V14.71L13.73,14.44C12.59,15.41 11.11,16 9.5,16A6.5,6.5 0 0,1 3,9.5A6.5,6.5 0 0,1 9.5,3M9.5,5C7,5 5,7 5,9.5C5,12 7,14 9.5,14C12,14 14,12 14,9.5C14,7 12,5 9.5,5Z</StreamGeometry>
    <StreamGeometry x:Key="IconSettings">M12,15.5A3.5,3.5 0 0,1 8.5,12A3.5,3.5 0 0,1 12,8.5A3.5,3.5 0 0,1 15.5,12A3.5,3.5 0 0,1 12,15.5M19.43,12.97C19.47,12.65 19.5,12.33 19.5,12C19.5,11.67 19.47,11.34 19.43,11L21.54,9.37C21.73,9.22 21.78,8.95 21.66,8.73L19.66,5.27C19.54,5.05 19.27,4.96 19.05,5.05L16.56,6.05C16.04,5.66 15.5,5.32 14.87,5.07L14.5,2.42C14.46,2.18 14.25,2 14,2H10C9.75,2 9.54,2.18 9.5,2.42L9.13,5.07C8.5,5.32 7.96,5.66 7.44,6.05L4.95,5.05C4.73,4.96 4.46,5.05 4.34,5.27L2.34,8.73C2.21,8.95 2.27,9.22 2.46,9.37L4.57,11C4.53,11.34 4.5,11.67 4.5,12C4.5,12.33 4.53,12.65 4.57,12.97L2.46,14.63C2.27,14.78 2.21,15.05 2.34,15.27L4.34,18.73C4.46,18.95 4.73,19.03 4.95,18.95L7.44,17.94C7.96,18.34 8.5,18.68 9.13,18.93L9.5,21.58C9.54,21.82 9.75,22 10,22H14C14.25,22 14.46,21.82 14.5,21.58L14.87,18.93C15.5,18.67 16.04,18.34 16.56,17.94L19.05,18.95C19.27,19.03 19.54,18.95 19.66,18.73L21.66,15.27C21.78,15.05 21.73,14.78 21.54,14.63L19.43,12.97Z</StreamGeometry>
    <StreamGeometry x:Key="IconGridOutline">M3,3H11V11H3V3M5,5V9H9V5H5M13,3H21V11H13V3M15,5V9H19V5H15M3,13H11V21H3V13M5,15V19H9V15H5M13,13H21V21H13V13M15,15V19H19V15H15Z</StreamGeometry>
    <StreamGeometry x:Key="IconCarouselOutline">M8,4H16A1,1 0 0,1 17,5V19A1,1 0 0,1 16,20H8A1,1 0 0,1 7,19V5A1,1 0 0,1 8,4M9,6V18H15V6H9M2,7H5V17H2V7M19,7H22V17H19V7Z</StreamGeometry>
    <StreamGeometry x:Key="IconMenu">M3,6H21V8H3V6M3,11H21V13H3V11M3,16H21V18H3V16Z</StreamGeometry>
    <StreamGeometry x:Key="IconPlay">M8,5.14V19.14L19,12.14L8,5.14Z</StreamGeometry>
    <StreamGeometry x:Key="IconFolderPlus">M10,4L12,6H20A2,2 0 0,1 22,8V18A2,2 0 0,1 20,20H4C2.89,20 2,19.1 2,18V6C2,4.89 2.89,4 4,4H10M15,9V12H12V14H15V17H17V14H20V12H17V9H15Z</StreamGeometry>
    <StreamGeometry x:Key="IconTune">M3,17V19H9V17H3M3,5V7H13V5H3M13,21V19H21V17H13V15H11V21H13M7,9V11H3V13H7V15H9V9H7M21,13V11H11V13H21M15,9H17V7H21V5H17V3H15V9Z</StreamGeometry>
    <StreamGeometry x:Key="IconLayers">M12,16L19.36,10.27L21,9L12,2L3,9L4.63,10.27M12,18.54L4.62,12.81L3,14.07L12,21.07L21,14.07L19.37,12.8L12,18.54Z</StreamGeometry>
    <StreamGeometry x:Key="IconImage">M8.5,13.5L11,16.5L14.5,12L19,18H5M21,19V5C21,3.89 20.1,3 19,3H5A2,2 0 0,0 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19Z</StreamGeometry>
    <StreamGeometry x:Key="IconGamepad">M7.97,16L5,19C4.67,19.3 4.23,19.5 3.75,19.5A1.75,1.75 0 0,1 2,17.75V17.5L3,10.12C3.21,7.81 5.14,6 7.5,6H16.5C18.86,6 20.79,7.81 21,10.12L22,17.5V17.75A1.75,1.75 0 0,1 20.25,19.5C19.77,19.5 19.33,19.3 19,19L16.03,16H7.97M7,8V10H5V11H7V13H8V11H10V10H8V8H7M16.5,8A0.75,0.75 0 0,0 15.75,8.75A0.75,0.75 0 0,0 16.5,9.5A0.75,0.75 0 0,0 17.25,8.75A0.75,0.75 0 0,0 16.5,8M14.75,9.75A0.75,0.75 0 0,0 14,10.5A0.75,0.75 0 0,0 14.75,11.25A0.75,0.75 0 0,0 15.5,10.5A0.75,0.75 0 0,0 14.75,9.75M18.25,9.75A0.75,0.75 0 0,0 17.5,10.5A0.75,0.75 0 0,0 18.25,11.25A0.75,0.75 0 0,0 19,10.5A0.75,0.75 0 0,0 18.25,9.75M16.5,11.5A0.75,0.75 0 0,0 15.75,12.25A0.75,0.75 0 0,0 16.5,13A0.75,0.75 0 0,0 17.25,12.25A0.75,0.75 0 0,0 16.5,11.5Z</StreamGeometry>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme>
      <FluentTheme.Palettes>
        <ColorPaletteResources x:Key="Dark" Accent="#C3A6FF" RegionColor="#10111E" />
      </FluentTheme.Palettes>
    </FluentTheme>

    <!-- Base typography and window colour for every window, including dialogs -->
    <Style Selector="Window">
      <Setter Property="FontFamily" Value="fonts:Inter#Inter, Segoe UI" />
      <Setter Property="Background" Value="{StaticResource SyBackground}" />
      <Setter Property="Foreground" Value="{StaticResource SyText}" />
    </Style>

    <!-- Accent (coral) buttons -->
    <Style Selector="Button.accent">
      <Setter Property="Background" Value="{StaticResource SyAccent}" />
      <Setter Property="Foreground" Value="{StaticResource SyOnAccent}" />
    </Style>
    <Style Selector="Button.accent:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource SyAccentHover}" />
      <Setter Property="Foreground" Value="{StaticResource SyOnAccent}" />
    </Style>
    <Style Selector="Button.accent:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource SyAccentPressed}" />
      <Setter Property="Foreground" Value="{StaticResource SyOnAccent}" />
    </Style>
    <Style Selector="Button.accent:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#5A4E85" />
      <Setter Property="Foreground" Value="#2A2440" />
    </Style>

    <Style Selector="Button.primary">
      <Setter Property="FontSize" Value="17" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="MinHeight" Value="46" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <!-- Quiet secondary buttons on surfaces -->
    <Style Selector="Button.subtle">
      <Setter Property="Background" Value="{StaticResource SySurface2}" />
      <Setter Property="BorderBrush" Value="{StaticResource SyBorder}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Padding" Value="14,6" />
    </Style>

    <!-- Expanders blend into the surface they sit on -->
    <Style Selector="Expander">
      <Setter Property="CornerRadius" Value="10" />
    </Style>
    <Style Selector="Expander /template/ ToggleButton#ExpanderHeader">
      <Setter Property="Background" Value="{StaticResource SySurface2}" />
      <Setter Property="BorderBrush" Value="{StaticResource SyBorder}" />
    </Style>
    <Style Selector="Expander /template/ ToggleButton#ExpanderHeader:pointerover /template/ Border#ToggleButtonBackground">
      <Setter Property="Background" Value="{StaticResource SyBorder}" />
    </Style>
    <Style Selector="Expander /template/ Border#ExpanderContent">
      <Setter Property="Background" Value="{StaticResource SySurface2}" />
      <Setter Property="BorderBrush" Value="{StaticResource SyBorder}" />
    </Style>

    <!-- Square icon buttons in the top bar -->
    <Style Selector="Button.icon, ToggleButton.icon">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="8" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Width" Value="38" />
      <Setter Property="Height" Value="38" />
    </Style>
    <Style Selector="ToggleButton.icon:checked /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource SySurface2}" />
      <Setter Property="Foreground" Value="{StaticResource SyAccent}" />
    </Style>
    <Style Selector="ToggleButton.icon:checked:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource SyBorder}" />
      <Setter Property="Foreground" Value="{StaticResource SyAccent}" />
    </Style>

    <!-- Text -->
    <Style Selector="TextBlock.warning, SelectableTextBlock.warning">
      <Setter Property="Foreground" Value="#F0A04B" />
    </Style>
    <Style Selector="TextBlock.muted, SelectableTextBlock.muted">
      <Setter Property="Foreground" Value="{StaticResource SyMuted}" />
    </Style>
    <Style Selector="TextBlock.error">
      <Setter Property="Foreground" Value="#F06262" />
    </Style>
    <Style Selector="TextBlock.section">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="LetterSpacing" Value="1.2" />
      <Setter Property="Foreground" Value="{StaticResource SyMuted}" />
    </Style>

    <!-- Library tabs as pills -->
    <Style Selector="TabStrip.pills">
      <Setter Property="Background" Value="{StaticResource SySurface}" />
    </Style>
    <Style Selector="TabStrip.pills TabStripItem">
      <Setter Property="FontSize" Value="17" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Padding" Value="20,8" />
      <Setter Property="Margin" Value="0,0,8,0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Foreground" Value="{StaticResource SyText}" />
    </Style>
    <Style Selector="TabStrip.pills TabStripItem:selected">
      <Setter Property="Background" Value="{StaticResource SyAccent}" />
      <Setter Property="Foreground" Value="{StaticResource SyOnAccent}" />
    </Style>
    <Style Selector="TabStrip.pills TabStripItem:selected:pointerover /template/ Border">
      <Setter Property="Background" Value="{StaticResource SyAccentHover}" />
    </Style>
    <Style Selector="TabStrip.pills TabStripItem:selected /template/ Border#PART_SelectedPipe">
      <Setter Property="IsVisible" Value="False" />
    </Style>

    <!-- Filter pills (All Games / Switch 1 / Switch 2) -->
    <Style Selector="ListBox.pills">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="ListBox.pills ListBoxItem">
      <Setter Property="Padding" Value="20,7" />
      <Setter Property="Margin" Value="0,0,10,0" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="FontSize" Value="15" />
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="Background" Value="{StaticResource SyGlass}" />
      <Setter Property="BorderBrush" Value="{StaticResource SyBorder}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="FocusAdorner" Value="{x:Null}" />
    </Style>
    <Style Selector="ListBox.pills ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource SyAccent}" />
      <Setter Property="Foreground" Value="{StaticResource SyOnAccent}" />
      <Setter Property="BorderBrush" Value="{StaticResource SyAccent}" />
    </Style>
    <Style Selector="ListBox.pills ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource SyAccentHover}" />
      <Setter Property="Foreground" Value="{StaticResource SyOnAccent}" />
    </Style>

    <!-- Grid / Carousel buttons with icon and label -->
    <Style Selector="ToggleButton.seg">
      <Setter Property="Background" Value="{StaticResource SyGlass}" />
      <Setter Property="BorderBrush" Value="{StaticResource SyBorder}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="16,8" />
      <Setter Property="FontSize" Value="15" />
    </Style>
    <Style Selector="ToggleButton.seg:checked /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource SyAccent}" />
      <Setter Property="Foreground" Value="{StaticResource SyOnAccent}" />
      <Setter Property="BorderBrush" Value="{StaticResource SyAccent}" />
    </Style>
    <Style Selector="ToggleButton.seg:checked:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource SyAccentHover}" />
      <Setter Property="Foreground" Value="{StaticResource SyOnAccent}" />
    </Style>

    <!-- Tags under a game's title (generation, genre) -->
    <Style Selector="Border.tag">
      <Setter Property="CornerRadius" Value="9" />
      <Setter Property="Padding" Value="14,5" />
      <Setter Property="Background" Value="#33363F5C" />
      <Setter Property="BorderBrush" Value="{StaticResource SyBorder}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Border.tag.accent">
      <Setter Property="Background" Value="{StaticResource SyChip}" />
      <Setter Property="BorderBrush" Value="#5B4C9C" />
    </Style>

    <!-- Controller hint glyphs in the footer -->
    <Style Selector="Border.key">
      <Setter Property="MinWidth" Value="30" />
      <Setter Property="Height" Value="30" />
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="BorderBrush" Value="#8A8DB0" />
      <Setter Property="BorderThickness" Value="1.5" />
      <Setter Property="Padding" Value="6,0" />
    </Style>
    <Style Selector="Border.key.round">
      <Setter Property="CornerRadius" Value="15" />
      <Setter Property="Width" Value="30" />
    </Style>
    <Style Selector="Border.key > TextBlock">
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="FontSize" Value="14" />
    </Style>

    <!-- Inputs on the dark surfaces -->
    <Style Selector="TextBox.search">
      <Setter Property="CornerRadius" Value="18" />
      <Setter Property="Padding" Value="34,7,12,7" />
      <Setter Property="Background" Value="{StaticResource SySurface2}" />
      <Setter Property="BorderBrush" Value="{StaticResource SyBorder}" />
    </Style>
    <Style Selector="ComboBox.chip">
      <Setter Property="CornerRadius" Value="16" />
      <Setter Property="Background" Value="{StaticResource SySurface2}" />
      <Setter Property="BorderBrush" Value="{StaticResource SyBorder}" />
      <Setter Property="MinHeight" Value="32" />
      <Setter Property="Padding" Value="12,4" />
    </Style>
  </Application.Styles>
</Application>
